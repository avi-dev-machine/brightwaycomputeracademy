APP_ENV=production
APP_BASE_URL=https://brightway-backend.onrender.com
PUBLIC_APP_URL=https://brightwaycomputeracademy.vercel.app
CORS_ORIGINS=https://brightwaycomputeracademy.vercel.app,http://localhost:3000

# MongoDB Atlas Connection String (Set in Render Environment Variables)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.cuq5qil.mongodb.net/brightway?retryWrites=true&w=majority
MONGODB_DB_NAME=brightway

# JWT Signing Secret
SUPABASE_JWT_SECRET=change-me-in-production-min-32-chars

# Razorpay Payment Gateway Credentials
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
RAZORPAY_WEBHOOK_SECRET=whsec_your_webhook_secret

# Messaging & Notifications (Fast2SMS / WhatsApp / Email)
WHATSAPP_PROVIDER=fast2sms
WHATSAPP_ACCESS_TOKEN=
SMS_PROVIDER=fast2sms
SMS_PROVIDER_API_KEY=
EMAIL_API_KEY=
